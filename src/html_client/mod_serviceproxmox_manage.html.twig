{% block js %}
   {#  {{ '/serviceproxmox/novnc/app.js' | script_tag }} #}

    {{ '/serviceproxmox/novnc/app/styles/input.css' | stylesheet_tag }}
    {{ '/serviceproxmox/novnc/app/styles/pve.css' | stylesheet_tag }}
    {{ '/serviceproxmox/novnc/app/error-handler.js' | script_tag }}
{% endblock %}
{% if order.status == 'active' %}
    {% set vm = client.serviceproxmox_vm_get({"order_id":order.id}) %}
    {% set server = client.serviceproxmox_server_get({"order_id":order.id}) %}
    <!-- get proxmox_service -->
    {% set proxmox_service = client.serviceproxmox_get_proxmox_service({"order_id":order.id}) %}
    <!-- get websocket infos from vm_cli -->

    <p class="text-center">
        Status: 
                
        {{ server.status }}

        <div class="control-group controls-row text-center">
            <a class="btn btn-success api-link" href="{{ 'api/client/serviceproxmox/vm_manage'|link({'order_id' : order.id, 'method' : 'start', 'CSRFToken': CSRFToken}) }}" data-api-confirm="{{ 'Are you sure?' | trans }}" data-api-msg="{{ 'VM starting. Reload page after a few moments.' | trans }}">
                {{ 'Start VM' | trans }}
            </a>
            <a class="btn btn-danger api-link" href="{{ 'api/client/serviceproxmox/vm_manage'|link({'order_id' : order.id, 'method' : 'shutdown', 'CSRFToken': CSRFToken}) }}" data-api-confirm="{{ 'Are you sure?' | trans }}" data-api-msg="{{ 'VM shutting down. Reload page after a few moments.' | trans }}">
                {{ 'Shutdown VM' | trans }}
            </a>
            <a class="btn btn-warning api-link" href="{{ 'api/client/serviceproxmox/vm_manage'|link({'order_id' : order.id, 'method' : 'reboot', 'CSRFToken': CSRFToken}) }}" data-api-confirm="{{ 'Are you sure?' | trans }}" data-api-msg="{{ 'VM rebooting. Reload page after a few moments.' | trans }}">
                {{ 'Reboot VM' | trans }}
            </a>
        </div>

        <h2>
            {{ 'Console' | trans }}
        </h2>
                
        {% if vm.status == "running" %}
            <button class="btn btn-info" id="btn-open-console">{{ 'Open Console' | trans }}</button>
            <script>
                document.getElementById('btn-open-console').addEventListener('click', function() {
                    API.client.post('serviceproxmox/vm_vncproxy', {
                        order_id: {{ order.id }},
                        CSRFToken: "{{ CSRFToken }}"
                    }, function(response) {
                        if (response.ticket) {
                            // We construct a Data URI or use document.write to inject a simple NoVNC viewer.
                            // This viewer loads the NoVNC library (proxied by FOSSBilling) and connects via WebSocket
                            // directly to the Proxmox server using the ticket.

                            var wss_url = "wss://" + response.hostname + ":8006/api2/json/nodes/" + response.node + "/" + response.type + "/" + response.vmid + "/vncwebsocket?port=" + response.port + "&vncticket=" + encodeURIComponent(response.ticket);

                            var win = window.open("", "_blank", "width=1024,height=768");
                            var html = `
<!DOCTYPE html>
<html>
<head>
    <title>Console: ` + response.vmid + `</title>
    <style>body { margin: 0; background-color: #333; height: 100%; display: flex; align-items: center; justify-content: center; }</style>
    <!-- Load noVNC scripts proxied via FOSSBilling -->
    <script type="module" crossorigin="anonymous">
        import RFB from '/serviceproxmox/novnc/core/rfb.js';

        // Connection details
        const url = "` + wss_url + `";

        // UI
        const rfb = new RFB(document.getElementById('screen'), url);
        rfb.scaleViewport = true;
        rfb.resizeSession = true;

        rfb.addEventListener("connect",  () => { console.log("Connected to " + url); });
        rfb.addEventListener("disconnect", () => { console.log("Disconnected"); });
        rfb.addEventListener("credentialsrequired", () => { console.log("Credentials required"); });
    <\/script>
</head>
<body>
    <div id="screen"></div>
</body>
</html>`;
                            win.document.write(html);
                            win.document.close();
                        }
                    });
                });
            </script>
        {% else %}
            {{ 'The server needs to be running to open the console.' | trans }}
        {% endif %}
        </p>

    {% endif %}
    